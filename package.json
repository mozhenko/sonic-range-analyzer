{
  "name": "sonic-range-pro",
  "version": "1.1.0",
  "description": "SonicRange Pro — Аудіометрія, вимірювання частотного діапазону слуху та вікторина для звукорежисерів (UA / EN)",
  "main": "electron-main.js",
  "author": "mozhenko (https://github.com/mozhenko)",
  "license": "MIT",
  "homepage": "https://mozhenko.github.io/sonic-range-analyzer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mozhenko/sonic-range-analyzer.git"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder -mw"
  },
  "build": {
    "appId": "com.mozhenko.sonicrange.pro",
    "productName": "SonicRange Pro",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "manifest.json",
      "icon.svg",
      "electron-main.js"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
