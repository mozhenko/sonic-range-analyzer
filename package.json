{
  "name": "sonic-range-pro",
  "version": "1.0.0",
  "description": "SonicRange Pro — Аудіометрія та вимірювання частотного діапазону слуху для звукорежисерів",
  "main": "electron-main.js",
  "author": "SonicRange Studio Lab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder -mw"
  },
  "build": {
    "appId": "com.sonicrange.pro.studio",
    "productName": "SonicRange Pro",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "manifest.json",
      "icon.svg",
      "electron-main.js"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
